{
  "manifest_version": 3,
  "name": "Habibi Thinks",
  "version": "0.1.0",
  "description": "Replace Claude's loading words on claude.ai with your own words.",
  "permissions": ["storage"],
  "host_permissions": ["https://claude.ai/*"],
  "content_scripts": [
    {
      "matches": ["https://claude.ai/*"],
      "js": ["words.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "options_page": "options.html"
}
